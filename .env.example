# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/malware_platform

# --- SMTP / Email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Malware Detection Platform
SMTP_USE_TLS=true

# --- Auth (shared with Member 1's User Management module) ---
JWT_SECRET_KEY=replace-with-a-strong-secret
JWT_ALGORITHM=HS256

# --- Optional: VirusTotal enrichment ---
VIRUSTOTAL_API_KEY=

# --- Alert & Notification Module (Member 6) ---
# Shared secret so the Threat Monitoring module can call POST /api/v1/alerts/ingest
# without a user JWT. Generate a strong random value for real deployments.
ALERT_INGEST_API_KEY=replace-with-a-strong-internal-key
# Minutes within which a repeated detection on the same file is treated as
# a duplicate rather than a new alert (see backend/app/alerts/service.py).
ALERT_DEDUP_WINDOW_MINUTES=15

# --- App ---
ENVIRONMENT=development
